@model AddResultViewModel
@{
    ViewData["Title"] = "Add Results";
}

<div class="card animate-in">
    <div class="card-header"><h2><i class="fas fa-poll"></i> @Model.CourseName — Add Results</h2></div>
    <div class="card-body">
        <form asp-action="AddResults" asp-controller="Teacher" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CourseId" value="@Model.CourseId" />
            <input type="hidden" name="Semester" value="@Model.Semester" />

            <div class="form-row" style="margin-bottom: 24px;">
                <div class="form-group"><label class="form-label">Exam Type</label>
                    <select name="ExamType" class="form-control"><option>Midterm</option><option>Final</option><option>Quiz</option><option>Assignment</option></select>
                </div>
                <div class="form-group"><label class="form-label">Total Marks</label>
                    <input type="number" name="TotalMarks" class="form-control" value="100" required />
                </div>
                <div class="form-group"><label class="form-label">Exam Date</label>
                    <input type="date" name="ExamDate" class="form-control" value="@Model.ExamDate.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="table-container">
                <table class="data-table">
                    <thead><tr><th>#</th><th>Roll Number</th><th>Student Name</th><th>Marks Obtained</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.Students.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td><span class="badge badge-primary">@Model.Students[i].RollNumber</span></td>
                                <td style="color: var(--text-primary); font-weight: 500;">@Model.Students[i].StudentName</td>
                                <td>
                                    <input type="hidden" name="Students[@i].StudentId" value="@Model.Students[i].StudentId" />
                                    <input type="hidden" name="Students[@i].StudentName" value="@Model.Students[i].StudentName" />
                                    <input type="hidden" name="Students[@i].RollNumber" value="@Model.Students[i].RollNumber" />
                                    <input type="number" name="Students[@i].MarksObtained" class="form-control" style="max-width: 120px;" min="0" max="200" value="0" required />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top: 24px; display: flex; gap: 12px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Results</button>
                <a href="/Teacher/MyCourses" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </form>
    </div>
</div>
