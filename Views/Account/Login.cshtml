@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — CMS Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                <div class="login-header">
                    <div class="login-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h1>Welcome Back</h1>
                    <p>Sign in to your CMS Portal account</p>
                </div>

                <form class="login-form" method="post" asp-action="Login" asp-controller="Account" id="loginForm">
                    @Html.AntiForgeryToken()

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div class="validation-error">
                                <i class="fas fa-exclamation-circle"></i> @error.ErrorMessage
                            </div>
                        }
                    }

                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <div class="form-input-wrapper">
                            <i class="fas fa-envelope"></i>
                            <input type="email" name="Email" id="emailInput" class="form-control" placeholder="Enter your email" required value="@Model?.Email" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <div class="form-input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="Password" id="passwordInput" class="form-control" placeholder="Enter your password" required value="@Model?.Password" />
                        </div>
                    </div>

                    <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" name="RememberMe" id="rememberMe" value="true" style="accent-color: var(--accent-primary);" />
                        <label for="rememberMe" style="font-size: 0.9rem; color: var(--text-secondary); cursor: pointer;">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Sign In
                    </button>
                </form>

                <div class="login-footer">
                    <p>Don't have an account? <a href="/Account/Register">Sign Up</a></p>
                    <p style="margin-top: 8px;"><a href="/" style="color: var(--text-muted);"><i class="fas fa-arrow-left"></i> Back to Home</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var email = document.getElementById("emailInput").value;
            var password = document.getElementById("passwordInput").value;
            if (email && password) {
                document.getElementById("loginForm").submit();
            }
        });
    </script>
</body>
</html>
