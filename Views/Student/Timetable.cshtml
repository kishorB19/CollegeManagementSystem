@model List<Timetable>
@{
    ViewData["Title"] = "Timetable";
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
    var byDay = Model.GroupBy(t => t.Day).ToDictionary(g => g.Key, g => g.OrderBy(t => t.StartTime).ToList());
}

<div class="card animate-in">
    <div class="card-header"><h2><i class="fas fa-calendar-alt"></i> Weekly Timetable</h2></div>
    <div class="card-body">
        @foreach (var day in days)
        {
            <div style="margin-bottom: 20px;">
                <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 10px; color: var(--accent-primary-light);">
                    <i class="fas fa-calendar-day" style="margin-right: 8px;"></i>@day
                </h3>
                @if (byDay.ContainsKey(day) && byDay[day].Any())
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;">
                        @foreach (var slot in byDay[day])
                        {
                            <div style="padding: 16px; background: var(--bg-glass); border: 1px solid var(--border-color); border-radius: var(--radius-md); border-left: 3px solid var(--accent-primary);">
                                <div style="font-weight: 600; font-size: 0.9rem; margin-bottom: 6px;">@slot.Course?.CourseName</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 4px;">
                                    <span><i class="fas fa-clock" style="width: 14px;"></i> @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                    <span><i class="fas fa-door-open" style="width: 14px;"></i> @slot.Room</span>
                                    <span><i class="fas fa-user" style="width: 14px;"></i> @slot.Course?.Teacher?.User?.FullName</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="padding: 12px 16px; background: var(--bg-glass); border-radius: var(--radius-sm); color: var(--text-muted); font-size: 0.9rem;">
                        No classes scheduled
                    </div>
                }
            </div>
        }
    </div>
</div>
