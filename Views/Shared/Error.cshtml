@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="empty-state" style="padding: 100px 20px;">
    <i class="fas fa-exclamation-triangle" style="font-size: 4rem; color: var(--warning); opacity: 0.5;"></i>
    <h3 style="font-size: 1.5rem; margin-top: 20px;">Something Went Wrong</h3>
    <p>An unexpected error occurred. Please try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 12px;">Request ID: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-primary" style="margin-top: 20px;"><i class="fas fa-home"></i> Go Home</a>
</div>
